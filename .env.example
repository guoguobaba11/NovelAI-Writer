# 环境变量示例
# 复制为 .env 后填入你的值

# AI 提供方：openai | anthropic | openai_compatible
NOVELAI_PROVIDER=openai

# 你的 API key
NOVELAI_API_KEY=sk-...

# 自定义 base_url（用于 OpenAI 兼容服务，如 DeepSeek、Moonshot、Ollama、智谱等）
# 留空则使用默认值
NOVELAI_BASE_URL=

# 主力模型（用于章节正文生成）
NOVELAI_MODEL=gpt-4o-mini

# 轻量模型（用于一致性检查、摘要、事件抽取）
NOVELAI_MINI_MODEL=gpt-4o-mini

# 数据库路径（可选）
# NOVELAI_DB=./data/novel.db
